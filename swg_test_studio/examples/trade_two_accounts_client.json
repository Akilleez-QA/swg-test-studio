{
  "format": "swg-test-studio", "schema_version": 1,
  "id": "trade_two_accounts_client",
  "title": "Two held client sessions trade a created item for credits, asserted from the server side",
  "category": "functional", "roles": ["seller", "buyer"],
  "steps": [
    {"id": "hold_seller", "action": "client", "options": {"role": "seller", "kind": "session_hold"}},
    {"id": "hold_buyer", "action": "client", "options": {"role": "buyer", "kind": "session_hold"}},
    {"id": "other_account", "action": "agent_fixture", "options": {"role": "seller", "op": "accountOf", "args": ["buyer"], "expect": {"same_account": "false"}}},
    {"id": "meet", "action": "agent_fixture", "options": {"role": "seller", "op": "bring", "args": ["buyer", "2"]}},
    {"id": "open_scenario", "action": "agent_fixture", "options": {"role": "seller", "op": "scenarioBegin", "args": ["trade_rod"]}},
    {"id": "make_rod", "action": "agent_fixture", "options": {"role": "seller", "op": "createInInventory", "args": ["object/tangible/loot/misc/recording_rod_s01.iff"], "scenario": "trade_rod"}},
    {"id": "fund_buyer", "action": "agent_fixture", "options": {"role": "seller", "op": "payTo", "args": ["buyer", "300"], "expect": {"requested": "true"}}},
    {"id": "before", "action": "agent_fixture", "options": {"role": "seller", "op": "snapshot", "args": ["rodtrade", "buyer"]}},
    {"id": "request", "action": "client", "options": {"role": "seller", "kind": "trade_request", "peer": "buyer"}},
    {"id": "accept", "action": "client", "options": {"role": "buyer", "kind": "trade_accept"}},
    {"id": "offer_rod", "action": "client", "options": {"role": "seller", "kind": "trade_add_item", "item_from": {"step": "make_rod", "row": 0}}},
    {"id": "pay", "action": "client", "options": {"role": "buyer", "kind": "trade_credits", "amount": 250}},
    {"id": "offer_seller", "action": "client", "options": {"role": "seller", "kind": "trade_offer"}},
    {"id": "offer_buyer", "action": "client", "options": {"role": "buyer", "kind": "trade_offer"}},
    {"id": "verify_seller", "action": "client", "options": {"role": "seller", "kind": "trade_verify"}},
    {"id": "verify_buyer", "action": "client", "options": {"role": "buyer", "kind": "trade_verify"}},
    {"id": "trade_closed", "action": "agent_fixture", "options": {"role": "seller", "op": "tradeState", "args": ["buyer"], "expect": {"bot_items_in_trade": "0", "partner_items_in_trade": "0"}}},
    {"id": "after", "action": "agent_fixture", "options": {"role": "seller", "op": "diff", "args": ["rodtrade", "buyer"], "expect": {"cash_delta": "250", "partner_cash_delta": "-250", "lost": "1", "partner_gained": "1", "credits_conserved": "true", "items_conserved": "true", "duplicated": "0"}}},
    {"id": "thanks", "action": "client", "options": {"role": "buyer", "kind": "tell", "peer": "seller", "text": "Thanks for the recording rod"}},
    {"id": "drop_snapshot", "action": "agent_fixture", "options": {"role": "seller", "op": "snapshotDrop", "args": ["rodtrade", "buyer"]}},
    {"id": "close_scenario", "action": "agent_fixture", "options": {"role": "seller", "op": "scenarioEnd", "args": ["trade_rod"]}},
    {"id": "release_seller", "action": "client", "options": {"role": "seller", "kind": "session_release"}},
    {"id": "release_buyer", "action": "client", "options": {"role": "buyer", "kind": "session_release"}}
  ],
  "review": {"approved": true, "recording": null, "unsupported": []}
}
